{
  "name": "chat-work-bridge",
  "version": "0.4.0-preview.1",
  "private": true,
  "type": "module",
  "description": "Windows ChatGPT web to WorkBuddy desktop bridge with durable task state",
  "license": "MIT",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "start": "node scripts/start.mjs",
    "initialize": "node scripts/initialize-session.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "config:check": "node scripts/check-config.mjs",
    "preflight": "node scripts/preflight.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "open-apps": "node scripts/open-apps.mjs",
    "launch:normal": "node scripts/launch-normal-workbuddy.mjs",
    "activate:normal": "node scripts/activate-normal-workbuddy.mjs",
    "launch:test": "node scripts/launch-workbuddy.mjs",
    "launch:gpt": "node scripts/launch-gpt-browser.mjs",
    "inspect": "node scripts/inspect-desktop.mjs"
